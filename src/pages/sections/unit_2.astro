---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle =
  "Unit 2: Array-Based Lists";
const unit = "Unit 2";
---

<BaseLayout
  title={pageTitle}
  unit={unit}
>
  <h1 class="text-3xl font-bold mb-4">
    {pageTitle}
  </h1>
  <hr class="mb-6" />

  <!-- List Implementations -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Pseudocode: Implementing a List
      Interface</summary
    >
    <ul
      class="list-disc list-inside mt-2 space-y-1"
    >
      <li>
        <strong
          >Define the class:</strong
        > MyList implements List
      </li>
      <li>
        <strong
          >Internal storage:</strong
        >
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            Declare storage (array or
            linked structure)
          </li>
          <li>Declare size = 0</li>
        </ul>
      </li>
      <li class="method">
        <strong>add(element):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If storage is full, expand
            storage
          </li>
          <li>
            Insert element at next index
          </li>
          <li>Increment size</li>
        </ul>
      </li>
      <li class="method">
        <strong>get(index):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If index &lt; 0 or &gt;=
            size, throw error
          </li>
          <li>
            Return element at index
          </li>
        </ul>
      </li>
      <li class="method">
        <strong>remove(index):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If index &lt; 0 or &gt;=
            size, throw error
          </li>
          <li>
            Shift elements after index
            left by 1
          </li>
          <li>Decrement size</li>
        </ul>
      </li>
      <li class="method">
        <strong>size():</strong> Return current
        size
      </li>
      <li class="method">
        <strong
          >contains(element):</strong
        >
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>Loop through storage</li>
          <li>
            If element matches, return
            true
          </li>
          <li>Else return false</li>
        </ul>
      </li>
      <li class="method">
        <strong
          >Optional methods:</strong
        >
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            isEmpty(): Return size == 0
          </li>
          <li>
            clear(): Remove all
            elements, set size = 0
          </li>
          <li>
            indexOf(element): Return
            index if found, else -1
          </li>
        </ul>
      </li>
    </ul>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >C Implementation (No Stdlib)</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm">
  <code class="language-c" set:html={`
#define MAX_SIZE 100

typedef struct {
    int data[MAX_SIZE];
    int size;
} MyList;

void initList(MyList* list) { list->size = 0; }
void add(MyList* list, int element) {
    if(list->size < MAX_SIZE) { list->data[list->size++] = element; }
}
int get(MyList* list, int index) {
    if(index >= 0 && index < list->size) return list->data[index];
    return -1;
}
void removeAt(MyList* list, int index) {
    if(index >= 0 && index < list->size) {
        for(int i = index; i < list->size - 1; i++) list->data[i] = list->data[i + 1];
        list->size--;
    }
}
int contains(MyList* list, int element) {
    for(int i = 0; i < list->size; i++) if(list->data[i] == element) return 1;
    return 0;
}
int size(MyList* list) { return list->size; }
  `} />
</pre>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Java Implementation</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
class MyList<E> {
    private Object[] data;
    private int size;
    private static final int CAPACITY = 100;

    public MyList() { data = new Object[CAPACITY]; size = 0; }

    public void add(E element) { if(size < CAPACITY) data[size++] = element; }

    public E get(int index) {
        if(index >= 0 && index < size) return (E) data[index];
        throw new IndexOutOfBoundsException();
    }

    public void remove(int index) {
        if(index >= 0 && index < size) {
            for(int i = index; i < size - 1; i++) data[i] = data[i + 1];
            size--;
        } else throw new IndexOutOfBoundsException();
    }

    public int size() { return size; }
    public boolean contains(E element) {
        for(int i = 0; i < size; i++) if(data[i].equals(element)) return true;
        return false;
    }
    public void clear() { size = 0; }
    public boolean isEmpty() { return size == 0; }
    public int indexOf(E element) {
        for(int i = 0; i < size; i++) if(data[i].equals(element)) return i;
        return -1;
    }
}
`}
</code></pre>
  </details>

  <!-- Queue Implementations -->
