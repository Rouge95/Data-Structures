        </ul>
      </li>
      <li class="method">
        <strong
          >enqueue(element):</strong
        >
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If storage is full, expand
            storage
          </li>
          <li>
            Insert element at rear index
          </li>
          <li>
