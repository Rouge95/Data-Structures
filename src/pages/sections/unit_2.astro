          <li>Return size == 0</li>
        </ul>
      </li>
    </ul>
    <iframe
      width="315"
      height="576"
      src="https://www.youtube.com/embed/TudVQmzFzDg"
      title="Circular Queue in Data Structure"
      frameborder="0"
      allowfullscreen></iframe>
    <p>
      Implementation is not circular.
    </p>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >C Implementation (No Stdlib) -
      Queue</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#define MAX_SIZE 100

typedef struct {
    int data[MAX_SIZE];
    int front;
    int rear;
    int size;
} MyQueue;

void initQueue(MyQueue* q) { q->front = q->rear = q->size = 0; }

void enqueue(MyQueue* q, int element) {
    if(q->size < MAX_SIZE) {
        q->data[q->rear] = element;
        q->rear = (q->rear + 1) % MAX_SIZE;
        q->size++;
    }
}

int dequeue(MyQueue* q) {
    if(q->size == 0) return -1;
    int element = q->data[q->front];
    q->front = (q->front + 1) % MAX_SIZE;
    q->size--;
    return element;
}

int peek(MyQueue* q) {
    if(q->size == 0) return -1;
    return q->data[q->front];
}

int isEmpty(MyQueue* q) { return q->size == 0; }
`}
</code></pre>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Java Implementation - Queue</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
class MyQueue<E> {
    private Object[] data;
    private int front;
    private int rear;
    private int size;
    private static final int CAPACITY = 100;

    public MyQueue() { data = new Object[CAPACITY]; front = rear = size = 0; }

    public void enqueue(E element) {
        if(size < CAPACITY) {
            data[rear] = element;
            rear = (rear + 1) % CAPACITY;
            size++;
        }
    }

    public E dequeue() {
        if(size == 0) throw new IllegalStateException("Queue is empty");
        E element = (E) data[front];
        front = (front + 1) % CAPACITY;
        size--;
        return element;
    }

    public E peek() {
        if(size == 0) throw new IllegalStateException("Queue is empty");
        return (E) data[front];
    }

    public boolean isEmpty() { return size == 0; }
}
`}
</code></pre>
  </details>

  <!-- Stack Implementations -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Pseudocode: Implementing a Stack
      Interface</summary
    >
    <ul
      class="list-disc list-inside mt-2 space-y-1"
    >
      <li>
        <strong
          >Define the class:</strong
        > MyStack implements Stack
      </li>
      <li>
        <strong
          >Internal storage:</strong
        >
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            Declare storage (array or
            linked structure)
          </li>
          <li>
            Declare top = -1 (empty
            stack)
          </li>
        </ul>
      </li>
      <li class="method">
        <strong>push(element):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If storage is full, expand
            storage
          </li>
          <li>Increment top</li>
          <li>
            Insert element at top index
          </li>
        </ul>
      </li>
      <li class="method">
        <strong>pop():</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If top == -1, throw error
            (stack empty)
          </li>
          <li>
            Return element at top index
          </li>
          <li>Decrement top</li>
        </ul>
      </li>
      <li class="method">
        <strong>peek():</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If top == -1, throw error
          </li>
          <li>
            Return element at top index
          </li>
        </ul>
      </li>
      <li class="method">
        <strong>isEmpty():</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            Return true if top == -1
          </li>
        </ul>
      </li>
      <li class="method">
        <strong>size():</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>Return top + 1</li>
        </ul>
      </li>
    </ul>
    <iframe
      width="315"
      height="576"
      src="https://www.youtube.com/embed/hAhlAcxN0GA"
      title="Stack Operations Explained"
      frameborder="0"
      allowfullscreen></iframe>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >C Implementation (No Stdlib) -
      Stack</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#define MAX_SIZE 100

typedef struct {
    int data[MAX_SIZE];
    int top;
} MyStack;

void initStack(MyStack* s) { s->top = -1; }

void push(MyStack* s, int element) {
    if(s->top < MAX_SIZE - 1) {
        s->top++;
        s->data[s->top] = element;
    }
}

int pop(MyStack* s) {
    if(s->top == -1) return -1;
    int element = s->data[s->top];
    s->top--;
    return element;
}

int peek(MyStack* s) {
    if(s->top == -1) return -1;
    return s->data[s->top];
}

int isEmpty(MyStack* s) { return s->top == -1; }

int size(MyStack* s) { return s->top + 1; }
`}
</code></pre>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Java Implementation - Stack</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
class MyStack<E> {
    private Object[] data;
    private int top;
    private static final int CAPACITY = 100;

    public MyStack() {
        data = new Object[CAPACITY];
        top = -1;
    }

    public void push(E element) {
        if(top < CAPACITY - 1) {
            top++;
            data[top] = element;
        }
    }

    public E pop() {
        if(top == -1) throw new IllegalStateException("Stack is empty");
        E element = (E) data[top];
        top--;
        return element;
    }

    public E peek() {
        if(top == -1) throw new IllegalStateException("Stack is empty");
        return (E) data[top];
    }

    public boolean isEmpty() { return top == -1; }

    public int size() { return top + 1; }
}
`}
</code></pre>
  </details>
