        </ul>
      </li>
      <li class="method">
        <strong>peek():</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            If size == 0, throw error
          </li>
          <li>
            Return element at front
            index
          </li>
        </ul>
      </li>
      <li class="method">
        <strong>isEmpty():</strong>
        <ul
          class="list-circle list-inside ml-4"
