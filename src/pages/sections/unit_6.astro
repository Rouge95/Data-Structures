---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Unit 6: Recursion";
const unit = "Unit 6";
---

<BaseLayout
  title={pageTitle}
  unit={unit}
>
  <h1 class="text-3xl font-bold mb-4">
    {pageTitle}
  </h1>
  <hr class="mb-6" />

  <!-- Decimal to Binary -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      Decimal to Binary (Recursion)
    </summary>

    <h4 class="font-semibold mt-3">
      C Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>

void decibinary(int num) {
    if (num < 2) {
        printf("%d", num);
    } else {
        decibinary(num / 2);
        printf("%d", num % 2);
    }
}

int main() {
    int n = 11;
    printf("Decimal: %d\\nBinary: ", n);
    decibinary(n);
    return 0;
}

/*
Output:
Decimal: 11
Binary: 1011
*/
`}
</code></pre>

    <h4 class="font-semibold mt-3">
      Java Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
public class DecimalToBinary {

    public static void decibinary(int num) {
        if (num < 2) {
            System.out.print(num);
        } else {
            decibinary(num / 2);
            System.out.print(num % 2);
        }
    }

    public static void main(String[] args) {
        int n = 11;
        System.out.print("Decimal: " + n + "\\nBinary: ");
        decibinary(n);
    }
}

/*
Output:
Decimal: 11
Binary: 1011
*/
`}
</code></pre>
  </details>

  <!-- Reverse String -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      Print String in Reverse
    </summary>

    <h4 class="font-semibold mt-3">
      C Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>
#include <string.h>

void print_reverse(char ss[], int n) {
    if (n == 1) {
        printf("%c", ss[0]);
    } else {
        printf("%c", ss[n-1]);
        print_reverse(ss, n-1);
    }
}

int main() {
    char str[] = "HELLO";
    printf("Original: %s\\nReversed: ", str);
    print_reverse(str, strlen(str));
    return 0;
}

/*
Output:
Original: HELLO
Reversed: OLLEH
*/
`}
</code></pre>

    <h4 class="font-semibold mt-3">
      Java Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
public class ReverseString {

    public static void printReverse(String s) {
        if (s.length() == 1) {
            System.out.print(s);
        } else {
            System.out.print(s.charAt(s.length() - 1));
            printReverse(s.substring(0, s.length() - 1));
        }
    }

    public static void main(String[] args) {
        String str = "HELLO";
        System.out.print("Original: " + str + "\\nReversed: ");
        printReverse(str);
    }
}

/*
Output:
Original: HELLO
Reversed: OLLEH
*/
`}
</code></pre>
  </details>

  <!-- Palindrome -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      Palindrome Check
    </summary>

    <h4 class="font-semibold mt-3">
      C Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>
#include <string.h>

int check(char str[], int len) {
    if (len <= 1)
        return 1;

    if (str[0] == str[len - 1] &&
        check(str + 1, len - 2))
        return 1;

    return 0;
}

int main() {
    char str[] = "racecar";

    if (check(str, strlen(str)))
        printf("%s is a palindrome\\n", str);
    else
        printf("%s is NOT a palindrome\\n", str);

    return 0;
}

/*
Output:
racecar is a palindrome
*/
`}
</code></pre>

    <h4 class="font-semibold mt-3">
      Java Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
public class Palindrome {

    public static boolean check(String s) {
        if (s.length() <= 1)
            return true;

        if (s.charAt(0) == s.charAt(s.length() - 1))
            return check(s.substring(1, s.length() - 1));

        return false;
    }

    public static void main(String[] args) {
        String str = "racecar";

        if (check(str))
            System.out.println(str + " is a palindrome");
        else
            System.out.println(str + " is NOT a palindrome");
    }
}

/*
Output:
racecar is a palindrome
*/
`}
</code></pre>
  </details>

  <!-- GCD -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      Greatest Common Divisor (Euclid)
    </summary>

    <h4 class="font-semibold mt-3">
      C Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>

int gcd(int p, int q) {
    if (q == 0)
        return p;
    return gcd(q, p % q);
}

int main() {
    int a = 1296;
    int b = 576;

    printf("GCD(%d, %d) = %d\\n", a, b, gcd(a, b));
    return 0;
}

/*
Output:
GCD(1296, 576) = 144
*/
`}
</code></pre>

    <h4 class="font-semibold mt-3">
      Java Implementation (Runnable)
    </h4>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
public class Euclid {

    public static int gcd(int p, int q) {
        if (q == 0)
            return p;
        return gcd(q, p % q);
    }

    public static void main(String[] args) {
        int a = 1296;
        int b = 576;

        System.out.println("GCD(" + a + ", " + b + ") = " + gcd(a, b));
    }
}

/*
Output:
GCD(1296, 576) = 144
*/
`}
</code></pre>
  </details>
</BaseLayout>
