    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
public class MyDoublyLinkedList<E> {

    private class Node {
        E value;
        Node next, prev;
        Node(E val){ value = val; }
    }

    private Node head, tail;
    private int size;

    public void add(E value){
        Node node = new Node(value);
        if(tail != null){
            tail.next = node;
            node.prev = tail;
        } else head = node;
        tail = node;
        size++;
    }

    public static void main(String[] args){
        MyDoublyLinkedList<Integer> list =
            new MyDoublyLinkedList<>();

        list.add(5);
        list.add(15);
        list.add(25);

        System.out.println("Inserted 3 elements");
    }
}
`}
