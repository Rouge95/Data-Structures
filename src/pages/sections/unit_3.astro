      C Implementation - Doubly Linked
      List
    </summary>

    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int value;
    struct Node* next;
    struct Node* prev;
} Node;

typedef struct {
    Node* head;
    Node* tail;
    int size;
} MyDoublyLinkedList;

void initList(MyDoublyLinkedList* list) {
    list->head = list->tail = NULL;
    list->size = 0;
}

void add(MyDoublyLinkedList* list, int value) {
    Node* node = malloc(sizeof(Node));
    node->value = value;
    node->next = NULL;
    node->prev = list->tail;

    if(list->tail) list->tail->next = node;
    else list->head = node;

    list->tail = node;
    list->size++;
}

int main() {
    MyDoublyLinkedList list;
    initList(&list);

    add(&list,5);
    add(&list,15);
    add(&list,25);

    printf("Size: %d\n", list.size);

    return 0;
}
`}
</code></pre>
