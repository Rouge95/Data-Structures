  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      C Implementation - Singly Linked
      List
    </summary>

    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int value;
    struct Node* next;
} Node;

typedef struct {
    Node* head;
    int size;
} MySinglyLinkedList;

void initList(MySinglyLinkedList* list) {
    list->head = NULL;
    list->size = 0;
}

void add(MySinglyLinkedList* list, int value) {
    Node* node = malloc(sizeof(Node));
    node->value = value;
    node->next = NULL;
    if(!list->head) list->head = node;
    else {
        Node* curr = list->head;
        while(curr->next) curr = curr->next;
        curr->next = node;
    }
    list->size++;
}

int get(MySinglyLinkedList* list, int index) {
    if(index < 0 || index >= list->size) return -1;
    Node* curr = list->head;
    for(int i=0;i<index;i++) curr = curr->next;
    return curr->value;
}

void removeAt(MySinglyLinkedList* list, int index) {
    if(index < 0 || index >= list->size) return;
    Node* curr = list->head;
    if(index == 0) {
        list->head = curr->next;
        free(curr);
    } else {
        for(int i=0;i<index-1;i++) curr = curr->next;
        Node* tmp = curr->next;
        curr->next = tmp->next;
        free(tmp);
    }
    list->size--;
}

int main() {
    MySinglyLinkedList list;
    initList(&list);

    add(&list,10);
    add(&list,20);
    add(&list,30);

    printf("Size: %d\n", list.size);
    printf("Index 1: %d\n", get(&list,1));

    removeAt(&list,1);

    printf("Size after remove: %d\n", list.size);
    printf("Index 1: %d\n", get(&list,1));

    return 0;
}
`}
</code></pre>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      Java Implementation - Singly
      Linked List
    </summary>

    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
public class MySinglyLinkedList<E> {

    private class Node {
        E value;
        Node next;
        Node(E val){ value = val; }
    }

    private Node head;
    private int size;

    public void add(E value) {
        Node node = new Node(value);
        if(head == null) head = node;
        else {
            Node curr = head;
            while(curr.next != null) curr = curr.next;
            curr.next = node;
        }
        size++;
    }

    public E get(int index) {
        Node curr = head;
        for(int i=0;i<index;i++) curr = curr.next;
        return curr.value;
    }

    public void remove(int index) {
        if(index == 0) head = head.next;
        else {
            Node curr = head;
            for(int i=0;i<index-1;i++) curr = curr.next;
            curr.next = curr.next.next;
        }
        size--;
    }

    public static void main(String[] args) {
        MySinglyLinkedList<Integer> list =
            new MySinglyLinkedList<>();

        list.add(10);
        list.add(20);
        list.add(30);

        System.out.println("Index 1: " + list.get(1));

        list.remove(1);

        System.out.println("Index 1 after remove: " +
            list.get(1));
    }
}
`}
</code></pre>
