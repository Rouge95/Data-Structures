---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle =
  "Unit 3: Linked Lists";
const unit = "Unit 3";
---

<BaseLayout
  title={pageTitle}
  unit={unit}
>
  <h1 class="text-3xl font-bold mb-4">
    {pageTitle}
  </h1>
  <hr class="mb-6" />

  <!-- Singly-Linked List -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Pseudocode: Singly-Linked List</summary
    >
    <ul
      class="list-disc list-inside mt-2 space-y-1"
    >
      <li>
        <strong>Define node:</strong> value,
        next
      </li>
      <li>
        <strong>Define class:</strong> MySinglyLinkedList
      </li>
      <li class="method">
        <strong>add(value):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>Create new node</li>
          <li>
            If head is null, head = new
            node
          </li>
          <li>
            Else traverse to last node
            and append
          </li>
          <li>Increment size</li>
        </ul>
      </li>
      <li class="method">
        <strong>get(index):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            Traverse nodes until index
          </li>
          <li>Return node value</li>
        </ul>
      </li>
      <li class="method">
        <strong>remove(index):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            Traverse to node before
            index
          </li>
          <li>
            Update next pointer to skip
            removed node
          </li>
          <li>Decrement size</li>
        </ul>
      </li>
      <li class="method">
        <strong>size():</strong> return size
      </li>
    </ul>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >C Implementation - Singly-Linked
      List</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdlib.h>

typedef struct Node {
    int value;
    struct Node* next;
} Node;

typedef struct {
    Node* head;
    int size;
} MySinglyLinkedList;

void initList(MySinglyLinkedList* list) {
    list->head = NULL;
    list->size = 0;
}

void add(MySinglyLinkedList* list, int value) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->value = value;
    node->next = NULL;
    if(!list->head) list->head = node;
    else {
        Node* curr = list->head;
        while(curr->next) curr = curr->next;
        curr->next = node;
    }
    list->size++;
}

int get(MySinglyLinkedList* list, int index) {
    if(index < 0 || index >= list->size) return -1;
    Node* curr = list->head;
    for(int i=0;i<index;i++) curr = curr->next;
    return curr->value;
}

void removeAt(MySinglyLinkedList* list, int index) {
    if(index < 0 || index >= list->size) return;
    Node* curr = list->head;
    if(index == 0) {
        list->head = curr->next;
        free(curr);
    } else {
        for(int i=0;i<index-1;i++) curr = curr->next;
        Node* tmp = curr->next;
        curr->next = tmp->next;
        free(tmp);
    }
    list->size--;
}
int size(MySinglyLinkedList* list) { return list->size; }
`}
</code></pre>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Java Implementation -
      Singly-Linked List</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
class MySinglyLinkedList<E> {
    private class Node {
        E value;
        Node next;
        Node(E val) { value = val; next = null; }
    }
    private Node head;
    private int size;

    public MySinglyLinkedList() { head = null; size = 0; }

    public void add(E value) {
        Node node = new Node(value);
        if(head == null) head = node;
        else {
            Node curr = head;
            while(curr.next != null) curr = curr.next;
            curr.next = node;
        }
        size++;
    }

    public E get(int index) {
        if(index < 0 || index >= size) throw new IndexOutOfBoundsException();
        Node curr = head;
        for(int i=0;i<index;i++) curr = curr.next;
        return curr.value;
    }

    public void remove(int index) {
        if(index < 0 || index >= size) throw new IndexOutOfBoundsException();
        if(index == 0) head = head.next;
        else {
            Node curr = head;
            for(int i=0;i<index-1;i++) curr = curr.next;
            curr.next = curr.next.next;
        }
        size--;
    }

    public int size() { return size; }
}
`}
</code></pre>
  </details>

  <!-- Doubly-Linked List -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Pseudocode: Doubly-Linked List</summary
    >
    <ul
      class="list-disc list-inside mt-2 space-y-1"
    >
      <li>
        <strong>Define node:</strong> value,
        next, prev
      </li>
      <li>
        <strong>Define class:</strong> MyDoublyLinkedList
      </li>
      <li class="method">
        <strong>add(value):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>Create node</li>
          <li>
            Append at tail; update prev
            pointer
          </li>
          <li>Increment size</li>
        </ul>
      </li>
      <li class="method">
        <strong>get(index):</strong> traverse
        from head or tail for efficiency
      </li>
      <li class="method">
        <strong>remove(index):</strong> update
        prev/next pointers
      </li>
    </ul>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >C Implementation - Doubly-Linked
      List</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdlib.h>

typedef struct DNode {
    int value;
    struct DNode* next;
    struct DNode* prev;
} DNode;

typedef struct {
    DNode* head;
    DNode* tail;
    int size;
} MyDoublyLinkedList;

void initList(MyDoublyLinkedList* list) {
    list->head = list->tail = NULL;
    list->size = 0;
}

void add(MyDoublyLinkedList* list, int value) {
    DNode* node = (DNode*)malloc(sizeof(DNode));
    node->value = value;
    node->next = NULL;
    node->prev = list->tail;
    if(list->tail) list->tail->next = node;
    else list->head = node;
    list->tail = node;
    list->size++;
}

int get(MyDoublyLinkedList* list, int index) {
    if(index < 0 || index >= list->size) return -1;
    DNode* curr = list->head;
    for(int i=0;i<index;i++) curr = curr->next;
    return curr->value;
}

void removeAt(MyDoublyLinkedList* list, int index) {
    if(index < 0 || index >= list->size) return;
    DNode* curr = list->head;
    for(int i=0;i<index;i++) curr = curr->next;
    if(curr->prev) curr->prev->next = curr->next;
    else list->head = curr->next;
    if(curr->next) curr->next->prev = curr->prev;
    else list->tail = curr->prev;
    free(curr);
    list->size--;
}
int size(MyDoublyLinkedList* list) { return list->size; }
`}
</code></pre>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Java Implementation -
      Doubly-Linked List</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
class MyDoublyLinkedList<E> {
    private class Node {
        E value;
        Node next, prev;
        Node(E val) { value = val; next = prev = null; }
    }
    private Node head, tail;
    private int size;

    public MyDoublyLinkedList() { head = tail = null; size = 0; }

    public void add(E value) {
        Node node = new Node(value);
        if(tail != null) { tail.next = node; node.prev = tail; }
        else head = node;
        tail = node;
        size++;
    }

    public E get(int index) {
        if(index < 0 || index >= size) throw new IndexOutOfBoundsException();
        Node curr = head;
        for(int i=0;i<index;i++) curr = curr.next;
        return curr.value;
    }

    public void remove(int index) {
        if(index < 0 || index >= size) throw new IndexOutOfBoundsException();
        Node curr = head;
        for(int i=0;i<index;i++) curr = curr.next;
        if(curr.prev != null) curr.prev.next = curr.next;
        else head = curr.next;
        if(curr.next != null) curr.next.prev = curr.prev;
        else tail = curr.prev;
        size--;
    }

    public int size() { return size; }
}
`}
</code></pre>
  </details>

  <!-- Space-Efficient Linked List -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Pseudocode: Space-Efficient
      Linked List</summary
    >
    <ul
      class="list-disc list-inside mt-2 space-y-1"
    >
      <li>
        <strong>Concept:</strong> store multiple
        elements per node to reduce pointer
        overhead
      </li>
      <li>
        <strong>Node structure:</strong> array
        of values + next pointer
      </li>
      <li class="method">
        <strong>add(value):</strong>
        <ul
          class="list-circle list-inside ml-4"
        >
          <li>
            Add to last node’s array if
            space
          </li>
          <li>
            Else allocate new node
          </li>
        </ul>
      </li>
      <li class="method">
        <strong>get(index):</strong> compute
        node and position within array
      </li>
      <li class="method">
        <strong>remove(index):</strong> remove
        from node array, shift elements
      </li>
    </ul>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >C Implementation -
      Space-Efficient Linked List</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdlib.h>
#define NODE_CAPACITY 4

typedef struct SE_Node {
    int values[NODE_CAPACITY];
    int count;
    struct SE_Node* next;
} SE_Node;

typedef struct {
    SE_Node* head;
    int size;
} SpaceEfficientList;

void initList(SpaceEfficientList* list) {
    list->head = NULL;
    list->size = 0;
}

void add(SpaceEfficientList* list, int value) {
    if(!list->head) {
        list->head = (SE_Node*)malloc(sizeof(SE_Node));
        list->head->values[0] = value;
        list->head->count = 1;
        list->head->next = NULL;
    } else {
        SE_Node* curr = list->head;
        while(curr->next) curr = curr->next;
        if(curr->count < NODE_CAPACITY) curr->values[curr->count++] = value;
        else {
            SE_Node* node = (SE_Node*)malloc(sizeof(SE_Node));
            node->values[0] = value;
            node->count = 1;
            node->next = NULL;
            curr->next = node;
        }
    }
    list->size++;
}

int get(SpaceEfficientList* list, int index) {
    if(index < 0 || index >= list->size) return -1;
    SE_Node* curr = list->head;
    while(index >= curr->count) {
        index -= curr->count;
        curr = curr->next;
    }
    return curr->values[index];
}
`}
</code></pre>
  </details>

  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
      >Java Implementation -
      Space-Efficient Linked List</summary
    >
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
class SpaceEfficientList<E> {
    private class Node {
        E[] values;
        int count;
        Node next;
        Node(int capacity) { values = (E[])new Object[capacity]; count = 0; next = null; }
    }
    private Node head;
    private int size;
    private static final int NODE_CAPACITY = 4;

    public SpaceEfficientList() { head = null; size = 0; }

    public void add(E value) {
        if(head == null) {
            head = new Node(NODE_CAPACITY);
            head.values[0] = value;
            head.count = 1;
        } else {
            Node curr = head;
            while(curr.next != null) curr = curr.next;
            if(curr.count < NODE_CAPACITY) curr.values[curr.count++] = value;
            else {
                Node node = new Node(NODE_CAPACITY);
                node.values[0] = value;
                node.count = 1;
                curr.next = node;
            }
        }
        size++;
    }

    public E get(int index) {
        if(index < 0 || index >= size) throw new IndexOutOfBoundsException();
        Node curr = head;
        while(index >= curr.count) {
            index -= curr.count;
            curr = curr.next;
        }
        return curr.values[index];
    }
}
`}
</code></pre>
  </details>
</BaseLayout>
