---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle =
  "Unit 5: Hash Functions and Hash Tables";
const unit = "Unit 5";
---

<BaseLayout
  title={pageTitle}
  unit={unit}
>
  <h1 class="text-3xl font-bold mb-4">
    {pageTitle}
  </h1>
  <hr class="mb-6" />

  <!-- Implementations -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      Hash Table Implementations
      (Runnable)
    </summary>

    <!-- LINEAR PROBING -->
    <h4 class="font-semibold mt-3">
      1. Linear Probing
    </h4>

    <h5 class="font-semibold mt-3">
      C Implementation
    </h5>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>

#define TABLE_SIZE 10
#define EMPTY -1

int table[TABLE_SIZE];

int hash(int key) { return key % TABLE_SIZE; }

void init() {
    for(int i = 0; i < TABLE_SIZE; i++)
        table[i] = EMPTY;
}

void insert(int key) {
    int idx = hash(key);
    for(int i = 0; i < TABLE_SIZE; i++) {
        int probe = (idx + i) % TABLE_SIZE;
        if(table[probe] == EMPTY) {
            table[probe] = key;
            return;
        }
    }
}

int search(int key) {
    int idx = hash(key);
    for(int i = 0; i < TABLE_SIZE; i++) {
        int probe = (idx + i) % TABLE_SIZE;
        if(table[probe] == key)
            return 1;
    }
    return 0;
}

int main() {
    init();
    insert(15);
    insert(25);
    insert(35);

    printf("Search 25: %d\\n", search(25));
    printf("Search 40: %d\\n", search(40));
    return 0;
}

/*
Output:
Search 25: 1
Search 40: 0
*/
`}
</code></pre>

    <h5 class="font-semibold mt-3">
      Java Implementation
    </h5>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
public class LinearProbing {

    static final int TABLE_SIZE = 10;
    static final int EMPTY = -1;
    static int[] table = new int[TABLE_SIZE];

    static int hash(int key) {
        return key % TABLE_SIZE;
    }

    static void init() {
        for(int i = 0; i < TABLE_SIZE; i++)
            table[i] = EMPTY;
    }

    static void insert(int key) {
        int idx = hash(key);
        for(int i = 0; i < TABLE_SIZE; i++) {
            int probe = (idx + i) % TABLE_SIZE;
            if(table[probe] == EMPTY) {
                table[probe] = key;
                return;
            }
        }
    }

    static boolean search(int key) {
        int idx = hash(key);
        for(int i = 0; i < TABLE_SIZE; i++) {
            int probe = (idx + i) % TABLE_SIZE;
            if(table[probe] == key)
                return true;
        }
        return false;
    }

    public static void main(String[] args) {
        init();
        insert(15);
        insert(25);
        insert(35);

        System.out.println("Search 25: " + search(25));
        System.out.println("Search 40: " + search(40));
    }
}

/*
Output:
Search 25: true
Search 40: false
*/
`}
</code></pre>

    <!-- SEPARATE CHAINING -->
    <h4 class="font-semibold mt-6">
      2. Separate Chaining
    </h4>

    <h5 class="font-semibold mt-3">
      C Implementation
    </h5>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>
#include <stdlib.h>

#define TABLE_SIZE 10

typedef struct Node {
    int key;
    struct Node* next;
} Node;

Node* table[TABLE_SIZE];

int hash(int key) { return key % TABLE_SIZE; }

void insert(int key) {
    int idx = hash(key);
    Node* newNode = malloc(sizeof(Node));
    newNode->key = key;
    newNode->next = table[idx];
    table[idx] = newNode;
}

int search(int key) {
    int idx = hash(key);
    Node* curr = table[idx];
    while(curr) {
        if(curr->key == key)
            return 1;
        curr = curr->next;
    }
    return 0;
}

int main() {
    insert(15);
    insert(25);
    insert(35);

    printf("Search 25: %d\\n", search(25));
    printf("Search 99: %d\\n", search(99));
    return 0;
}

/*
Output:
Search 25: 1
Search 99: 0
*/
`}
</code></pre>

    <h5 class="font-semibold mt-3">
      Java Implementation
    </h5>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
import java.util.LinkedList;

public class SeparateChaining {

    static final int TABLE_SIZE = 10;
    static LinkedList<Integer>[] table = new LinkedList[TABLE_SIZE];

    static int hash(int key) {
        return key % TABLE_SIZE;
    }

    static void init() {
        for(int i = 0; i < TABLE_SIZE; i++)
            table[i] = new LinkedList<>();
    }

    static void insert(int key) {
        table[hash(key)].add(key);
    }

    static boolean search(int key) {
        return table[hash(key)].contains(key);
    }

    public static void main(String[] args) {
        init();
        insert(15);
        insert(25);
        insert(35);

        System.out.println("Search 25: " + search(25));
        System.out.println("Search 99: " + search(99));
    }
}

/*
Output:
Search 25: true
Search 99: false
*/
`}
</code></pre>

    <!-- DOUBLE HASHING -->
    <h4 class="font-semibold mt-6">
      3. Double Hashing
    </h4>

    <h5 class="font-semibold mt-3">
      C Implementation
    </h5>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdio.h>

#define TABLE_SIZE 10
#define EMPTY -1

int table[TABLE_SIZE];

int hash1(int key) { return key % TABLE_SIZE; }
int hash2(int key) { return 1 + (key % (TABLE_SIZE - 1)); }

void init() {
    for(int i = 0; i < TABLE_SIZE; i++)
        table[i] = EMPTY;
}

void insert(int key) {
    int idx = hash1(key);
    int step = hash2(key);

    for(int i = 0; i < TABLE_SIZE; i++) {
        int probe = (idx + i * step) % TABLE_SIZE;
        if(table[probe] == EMPTY) {
            table[probe] = key;
            return;
        }
    }
}

int search(int key) {
    int idx = hash1(key);
    int step = hash2(key);

    for(int i = 0; i < TABLE_SIZE; i++) {
        int probe = (idx + i * step) % TABLE_SIZE;
        if(table[probe] == key)
            return 1;
    }
    return 0;
}

int main() {
    init();
    insert(15);
    insert(25);
    insert(35);

    printf("Search 35: %d\\n", search(35));
    printf("Search 100: %d\\n", search(100));
    return 0;
}

/*
Output:
Search 35: 1
Search 100: 0
*/
`}
</code></pre>

