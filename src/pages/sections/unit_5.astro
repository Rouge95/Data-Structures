    static void init() {
        for(int i = 0; i < TABLE_SIZE; i++)
            table[i] = EMPTY;
    }

    static void insert(int key) {
        int idx = hash1(key);
        int step = hash2(key);

        for(int i = 0; i < TABLE_SIZE; i++) {
            int probe = (idx + i * step) % TABLE_SIZE;
            if(table[probe] == EMPTY) {
                table[probe] = key;
                return;
            }
        }
    }

    static boolean search(int key) {
        int idx = hash1(key);
        int step = hash2(key);

        for(int i = 0; i < TABLE_SIZE; i++) {
            int probe = (idx + i * step) % TABLE_SIZE;
            if(table[probe] == key)
