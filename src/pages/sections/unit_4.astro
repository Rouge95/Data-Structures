{`
#include <stdlib.h>
#include <stdio.h>
#include <time.h>

#define MAX_LEVEL 6
#define P 0.5

typedef struct Node {
    int value;
    struct Node* forward[MAX_LEVEL + 1];
} Node;

typedef struct {
    int level;
    Node* header;
} SkipList;

int randomLevel() {
    int level = 0;
    while ((rand() / (double)RAND_MAX) < P && level < MAX_LEVEL)
        level++;
    return level;
}

Node* createNode(int value) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->value = value;
    for(int i = 0; i <= MAX_LEVEL; i++)
        node->forward[i] = NULL;
    return node;
}

void initSkipList(SkipList* list) {
    list->level = 0;
    list->header = createNode(-1);
}

void insert(SkipList* list, int value) {
    Node* update[MAX_LEVEL + 1];
    Node* x = list->header;

    for(int i = list->level; i >= 0; i--) {
        while(x->forward[i] && x->forward[i]->value < value)
            x = x->forward[i];
        update[i] = x;
    }

    x = x->forward[0];

    if(x == NULL || x->value != value) {
        int lvl = randomLevel();

        if(lvl > list->level) {
            for(int i = list->level + 1; i <= lvl; i++)
                update[i] = list->header;
            list->level = lvl;
        }

        x = createNode(value);

        for(int i = 0; i <= lvl; i++) {
            x->forward[i] = update[i]->forward[i];
            update[i]->forward[i] = x;
        }
    }
}

int search(SkipList* list, int value) {
    Node* x = list->header;

    for(int i = list->level; i >= 0; i--) {
        while(x->forward[i] && x->forward[i]->value < value)
            x = x->forward[i];
    }

    x = x->forward[0];

    return (x && x->value == value);
}

/* ===========================
   MAIN RUNTIME EXAMPLE
   =========================== */

int main() {
    srand(time(NULL));

    SkipList list;
    initSkipList(&list);

    printf("Inserting: 20, 30, 40\\n");
    insert(&list, 20);
    insert(&list, 30);
    insert(&list, 40);

    printf("Search 30: %s\\n",
        search(&list, 30) ? "Found" : "Not Found");

    printf("Search 25: %s\\n",
        search(&list, 25) ? "Found" : "Not Found");

    return 0;
}

/*
Expected Output (example):

Inserting: 20, 30, 40
Search 30: Found
Search 25: Not Found
*/
`}
