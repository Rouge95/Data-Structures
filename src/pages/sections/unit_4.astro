      Java Implementation - Skip List
    </summary>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-java">
{`
import java.util.Random;

// Skip List implementation with probabilistic balancing
class SkipList {

    // Node class stores value and forward references
    static class Node {
        int value;
        Node[] forward;

        Node(int value, int level) {
            this.value = value;
            forward = new Node[level + 1]; // Allocate levels
        }
    }

    private static final int MAX_LEVEL = 6; // Max height
    private static final double P = 0.5;    // Probability factor

    private final Node header = new Node(-1, MAX_LEVEL); // Sentinel
    private int level = 0;                                 // Current highest level
    private final Random rand = new Random();

    // Generate random level
    private int randomLevel() {
        int lvl = 0;
        while(rand.nextDouble() < P && lvl < MAX_LEVEL)
            lvl++;  // Increase height with probability P
        return lvl;
    }

    // Insert a value
    public void insert(int value) {
        Node[] update = new Node[MAX_LEVEL + 1];
        Node x = header;

        // Traverse from top level down
        for(int i = level; i >= 0; i--) {
            while(x.forward[i] != null &&
                  x.forward[i].value < value)
                x = x.forward[i];

            update[i] = x; // Save path
        }

        x = x.forward[0];

        // Insert only if not duplicate
        if(x == null || x.value != value) {
            int lvl = randomLevel();

            // If new level exceeds current, adjust header references
            if(lvl > level) {
                for(int i = level + 1; i <= lvl; i++)
                    update[i] = header;
                level = lvl;
            }

            Node newNode = new Node(value, lvl);

            // Re-link pointers
            for(int i = 0; i <= lvl; i++) {
                newNode.forward[i] = update[i].forward[i];
                update[i].forward[i] = newNode;
            }
        }
    }

    // Search for a value
    public boolean search(int value) {
        Node x = header;

        // Traverse levels top-down
        for(int i = level; i >= 0; i--) {
            while(x.forward[i] != null &&
                  x.forward[i].value < value)
                x = x.forward[i];
        }

        x = x.forward[0];

        return x != null && x.value == value;
    }
}
`}
