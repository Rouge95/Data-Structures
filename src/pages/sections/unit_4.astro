---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Unit 3: Skip Lists";
const unit = "Unit 3";
---

<BaseLayout
  title={pageTitle}
  unit={unit}
>
  <h1 class="text-3xl font-bold mb-4">
    {pageTitle}
  </h1>
  <hr class="mb-6" />

  <!-- Skip List Overview -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      Pseudocode: Skip List
    </summary>
    <p>
      <i
        >The probability factor controls
        how tall nodes become. In a skip
        list: Every node starts at level
        0. It may get promoted to higher
        levels. Promotion happens
        randomly. P determines how often
        that promotion happens.</i
      >
    </p>
    <hr />
    <p>
      Level 3: 20 ─────────────► 40 <br
      />
      Level 2: 20 ─────────────► 40 <br
      />
      Level 1: 20 ──► 30 ─────► 40 <br
      />
      Level 0: 20 ──► 30 ─────► 40 <br
      />Now: <br />20.forward[3] → 40 <br
      />20.forward[2] → 40 20.forward[1]
      → 30<br /> 20.forward[0] → 30<br
      />
    </p>
    <hr /><br />
    <iframe
      width="315"
      height="576"
      src="https://www.youtube.com/embed/ypod5jeYzAU"
      title="Skip List | Set 1 (Introduction) | GeeksforGeeks"
      frameborder="0"
      allowfullscreen></iframe>
  </details>

  <!-- C Implementation -->
  <details
    class="mb-4 border rounded p-4"
  >
    <summary
      class="cursor-pointer font-semibold"
    >
      C Implementation - Skip List
    </summary>
    <pre
      class="bg-gray-100 p-2 rounded overflow-x-auto text-sm"><code class="language-c">
{`
#include <stdlib.h>
#include <stdio.h>
#include <time.h>

#define MAX_LEVEL 6      // Maximum height of the skip list
#define P 0.5            // Probability factor for level generation

// Node structure: contains value and forward pointers for each level
typedef struct Node {
    int value;
    struct Node* forward[MAX_LEVEL + 1]; //! Each node stores pointers to the next greater value at that level.
} Node;

// SkipList structure: tracks current highest level and header node
typedef struct {
    int level;           // Current highest level in use
    Node* header;        // Sentinel head node
} SkipList;

// Randomly generate a level using probability P
int randomLevel() {
    int level = 0;
    while ((rand() / (double)RAND_MAX) < P && level < MAX_LEVEL)
        level++;         // Increase level with probability P
    return level;
}

// Create a new node with given value
Node* createNode(int value, int level) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->value = value;

    // Initialize all forward pointers to NULL
    for(int i = 0; i <= MAX_LEVEL; i++)
        node->forward[i] = NULL;

    return node;
}

// Initialize skip list
void initSkipList(SkipList* list) {
    list->level = 0;                         // Start at level 0
    list->header = createNode(-1, MAX_LEVEL); // Sentinel node
}

// Insert value into skip list
void insert(SkipList* list, int value) {
    Node* update[MAX_LEVEL + 1]; // Previous nodes to rewire into. If we stored copies of nodes, modifying them wouldn’t affect the list.
    Node* x = list->header;

    // Start from highest level and move down
    for(int i = list->level; i >= 0; i--) {
        while(x->forward[i] && x->forward[i]->value < value)
            x = x->forward[i];   // Move forward at current level
        update[i] = x;           // Save node before insertion point
    }

    x = x->forward[0];

    // Insert only if value not already present
    if(x == NULL || x->value != value) {
        int lvl = randomLevel();

        // If new level is higher, initialize update references
        if(lvl > list->level) {
            for(int i = list->level + 1; i <= lvl; i++)
                update[i] = list->header;
            list->level = lvl;
        }

        // Create new node
        x = createNode(value, lvl);

        // Re-link pointers at each level
        for(int i = 0; i <= lvl; i++) {
            x->forward[i] = update[i]->forward[i];
            update[i]->forward[i] = x;
        }
    }
}

// Search for a value
int search(SkipList* list, int value) {
    Node* x = list->header;

    // Traverse from highest level down
    for(int i = list->level; i >= 0; i--) {
        while(x->forward[i] && x->forward[i]->value < value)
            x = x->forward[i];
    }

    x = x->forward[0];

    // Return 1 if found, 0 otherwise
    return (x && x->value == value);
}
`}
</code></pre>
