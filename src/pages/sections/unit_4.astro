import java.util.Random;

public class SkipList {

    static class Node {
        int value;
        Node[] forward;

        Node(int value, int level) {
            this.value = value;
            forward = new Node[level + 1];
        }
    }

    private static final int MAX_LEVEL = 6;
    private static final double P = 0.5;

    private final Node header = new Node(-1, MAX_LEVEL);
    private int level = 0;
    private final Random rand = new Random();

    private int randomLevel() {
        int lvl = 0;
        while(rand.nextDouble() < P && lvl < MAX_LEVEL)
            lvl++;
        return lvl;
    }

    public void insert(int value) {
        Node[] update = new Node[MAX_LEVEL + 1];
        Node x = header;

        for(int i = level; i >= 0; i--) {
            while(x.forward[i] != null &&
                  x.forward[i].value < value)
                x = x.forward[i];

            update[i] = x;
        }

        x = x.forward[0];

        if(x == null || x.value != value) {
            int lvl = randomLevel();

            if(lvl > level) {
                for(int i = level + 1; i <= lvl; i++)
                    update[i] = header;
                level = lvl;
            }

            Node newNode = new Node(value, lvl);

            for(int i = 0; i <= lvl; i++) {
                newNode.forward[i] = update[i].forward[i];
                update[i].forward[i] = newNode;
            }
        }
    }

    public boolean search(int value) {
        Node x = header;

        for(int i = level; i >= 0; i--) {
            while(x.forward[i] != null &&
                  x.forward[i].value < value)
                x = x.forward[i];
        }

        x = x.forward[0];

        return x != null && x.value == value;
    }

    /* ===========================
       MAIN RUNTIME EXAMPLE
       =========================== */

    public static void main(String[] args) {
        SkipList list = new SkipList();

        System.out.println("Inserting: 20, 30, 40");
        list.insert(20);
        list.insert(30);
        list.insert(40);

        System.out.println("Search 30: " +
            (list.search(30) ? "Found" : "Not Found"));

        System.out.println("Search 25: " +
            (list.search(25) ? "Found" : "Not Found"));
    }
}

/*
Expected Output (example):

Inserting: 20, 30, 40
Search 30: Found
Search 25: Not Found
*/
`}
