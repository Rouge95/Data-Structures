---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HighlightScript from "../components/HighlightScript.astro";

const { title, unit } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{title}</title>

    <!-- Tailwind or global styles -->
    <link
      rel="stylesheet"
      href="/styles/global.css"
    />

    <!-- Highlight.js styles -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/default.min.css"
    />
  </head>

  <body
    class="bg-gray-50 text-gray-800"
  >
    <!-- Header -->
    <Header />

    <main
      class="w-full md:max-w-4xl lg:max-w-6xl xl:max-w-7xl mx-auto p-6 lg:p-8 xl:p-12"
    >
      <!-- Breadcrumb -->
      {
        unit && (
          <nav class="breadcrumb text-sm mb-4">
            <a
              href="https://rouge95.github.io/Data-Structures/"
              class="text-blue-600 hover:underline"
            >
              Index
            </a>{" "}
            &gt;
            <span class="font-semibold">
              {unit}
            </span>
          </nav>
        )
      }

      <!-- Page content -->
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Highlight.js script -->
    <!-- Highlight.js -->
    <HighlightScript />
  </body>
</html>
